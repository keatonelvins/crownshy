{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "crownshy",
	"main": "./worker/index.ts",
	"compatibility_date": "2026-09-03",
	"compatibility_flags": ["nodejs_compat"],
	"assets": {
		"directory": "./dist",
		"run_worker_first": ["/api/*"]
	},
	"d1_databases": [
		{
			"binding": "BOARD_DB",
			"database_name": "crownshy-board",
			"database_id": "a0d719ef-7eea-4b64-934d-d02bae46c878",
			"migrations_dir": "./migrations"
		}
	],
	"secrets": {
		"required": ["BOARD_PASSWORD"]
	},
	"triggers": {
		"crons": ["0 * * * *"]
	},
	"observability": {
		"enabled": true,
		"logs": {
			"enabled": true,
			"head_sampling_rate": 1
		}
	}
}
